# Frontend (Next.js / Vercel) - safe to expose to the browser, this is the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Scraper only (GitHub Actions secrets, or a local .env when running `npm run scrape`).
# SUPABASE_URL is the same project URL as above under a different name - Vercel
# needs the NEXT_PUBLIC_ prefix to expose it to the browser, GitHub Actions doesn't.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security - never expose it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=